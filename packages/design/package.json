{
  "name": "@9thbit-llc/sm-urb-design",
  "version": "0.1.1",
  "description": "Shared design language for StructuredMerge and Ur Brain: tokens, themes, and Svelte components on Skeleton and Lucide.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9thBit-llc/sm-urb-design.git",
    "directory": "packages/design"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "build": "pnpm build:themes && svelte-package -i src/lib -o dist",
    "build:themes": "node scripts/generate-themes.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@lucide/svelte": "^1.64.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "svelte": "^5.40.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.64.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0"
  }
}
